{
  "name": "rebuilder-framework-cli",
  "version": "1.1.0",
  "type": "module",

  "main": "dist/electron/main.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./factory": {
      "types": "./dist/factory.d.ts",
      "import": "./dist/factory.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "import": "./dist/navigation.js"
    },
    "./electron": {
      "types": "./dist/electron/main.d.ts",
      "import": "./dist/electron/main.js",
      "require": "./dist/electron/main.cjs"
    }
  },

  "files": [
    "dist",
    "ui",
    "tsconfig.json",
    "index.html",
    "global.d.ts"
  ],

  "bin": {
    "create-router": "dist/cli/index.js",
    "rebuilder": "dist/cli/index.js"
  },

  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run build:lib && npm run build:cli",
    "build:lib": "tsup",
    "build:cli": "npm --prefix src/cli run build",
    "prepublishOnly": "npm run build",
    "create-router": "node dist/cli/index.js",
    "preview": "vite preview"
  },

  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.10",
    "@types/node": "^26.2.0",
    "electron": "^43.4.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "tsup": "^8.0.0"
  },

  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "chalk": "^6.0.0",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "fs-extra": "^11.4.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}