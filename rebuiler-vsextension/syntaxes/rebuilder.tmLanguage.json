{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rebuilder",
  "scopeName": "source.rebuilder",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#rfactory" },
    { "include": "#state" },
    { "include": "#metadata" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.rebuilder",
          "match": "//.*$"
        },
        {
          "name": "comment.block.rebuilder",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.rebuilder",
          "begin": "\"",
          "end": "\""
        },
        {
          "name": "string.quoted.single.rebuilder",
          "begin": "'",
          "end": "'"
        },
        {
          "name": "string.template.rebuilder",
          "begin": "`",
          "end": "`"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rebuilder",
          "match": "\\b(export|default|function|return|const|let|var|if|else|for|while|async|await)\\b"
        },
        {
          "name": "storage.type.rebuilder",
          "match": "\\b(interface|type|class|extends|implements)\\b"
        },
        {
          "name": "constant.language.boolean.rebuilder",
          "match": "\\b(true|false|null|undefined)\\b"
        },
        {
          "name": "constant.numeric.rebuilder",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "rfactory": {
      "patterns": [
        {
          "name": "entity.name.function.factory.rebuilder",
          "match": "\\br\\.(div|button|span|input|form|h1|h2|h3|h4|h5|h6|p|a|img|ul|ol|li|section|header|footer|nav|main|aside|article|textarea|select|label|table|thead|tbody|tr|td|th|iframe|video|audio|canvas)\\b"
        },
        {
          "name": "entity.name.function.factory.rebuilder",
          "match": "\\br\\s*\\("
        }
      ]
    },
    "state": {
      "patterns": [
        {
          "name": "entity.name.function.state.rebuilder",
          "match": "\\b(useState|useFormState|createState|createRef|useRef)\\b"
        },
        {
          "name": "variable.other.object.property.rebuilder",
          "match": "\\.(value|set|update|subscribe|reset)\\b"
        }
      ]
    },
    "metadata": {
      "patterns": [
        {
          "name": "entity.name.tag.metadata.rebuilder",
          "match": "\\b(metadata|window|title|path|requireAuth|layout|transition)\\s*:"
        }
      ]
    },
    "component": {
      "patterns": [
        {
          "name": "entity.name.function.component.rebuilder",
          "match": "\\bexport\\s+default\\s+function\\s+([A-Z][a-zA-Z0-9]*)\\b",
          "captures": {
            "1": { "name": "entity.name.function.rebuilder" }
          }
        }
      ]
    }
  }
}